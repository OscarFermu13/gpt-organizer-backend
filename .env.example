# ── Base de datos ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/gptorganizer

# ── Autenticación ─────────────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=a_long_random_secret_string_change_me

# ── Stripe ────────────────────────────────────────────────────────────────────
# Claves disponibles en https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Secret del webhook — se obtiene al crear el endpoint en el dashboard de Stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# ID del precio del plan Pro — se obtiene en Stripe > Products
STRIPE_PRICE_ID=price_...

# ── URLs ──────────────────────────────────────────────────────────────────────
# URL del frontend
FRONTEND_URL=http://localhost:3000

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=4000
